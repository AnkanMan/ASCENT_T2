<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup, Android 12 and later (PHASE5.md section 3, "Second layer"): the
   game database and the game settings, so a new phone on the same Google account
   restores automatically. A fallback: the main path is the backup folder.
   Never included: the device-local backup bookkeeping (ascent_backup) and the backup
   work folder (staging, pre-restore backup).
   The app is stopped while Android backs up, so the database and its WAL are quiet.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="ascent.db" />
        <include domain="database" path="ascent.db-wal" />
        <include domain="file" path="datastore/ascent_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ascent.db" />
        <include domain="database" path="ascent.db-wal" />
        <include domain="file" path="datastore/ascent_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
